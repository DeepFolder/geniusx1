# Required; npm run setup generates local database and signing secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use disable only for local/private database connections; use verify for hosted TLS.
DATABASE_SSL=disable
SESSION_SECRET=
JWT_SECRET=

# Required for AI generation. The workspace and saved calculations work without it.
OPENAI_API_KEY=

# Local development database (generated by npm run setup)
LOCAL_DATABASE_DRIVER=native
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

# Optional runtime configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
ENABLE_STARTUP_AI_JOBS=false
LLM_PROVIDER=openai
LLM_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
ENABLE_WEB_SEARCH=true
ENABLE_FILESYSTEM_SCAN=false
AI_AGENT_TEMPERATURE=
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
SITE_URL=http://localhost:5000

# Optional Replit object storage
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
LEGAL_ADMIN_EMAIL=
